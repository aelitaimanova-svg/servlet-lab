{
  "name": "Servlet Lab",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "installMaven": "true"
    }
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "Tomcat", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": { "extensions": ["vscjava.vscode-java-pack"] }
  },
  "postAttachCommand": "cd lab && bash run.sh"
}
